{
  "format": "ethereal-preset",
  "version": 1,
  "app_version": "0.2.0",
  "preset": {
    "name": "De-Harsh",
    "device": {
      "type": "Builtin",
      "device": "MultibandCompressor"
    },
    "meta": {
      "tags": [
        "cymbals",
        "de-ess",
        "highs"
      ],
      "author": "Ethereal",
      "description": "Fast 4:1 compression above 3.5 kHz catches harsh cymbals and sibilance; lows and mids pass untouched."
    },
