{
  "format": "ethereal-preset",
  "version": 1,
  "app_version": "0.2.0",
  "preset": {
    "name": "Trance Sixteenths",
    "device": {
      "type": "Builtin",
      "device": "Arpeggiator"
    },
    "meta": {
      "tags": [
        "arp",
        "trance",
        "latch"
      ],
      "author": "Ethereal",
      "description": "Up-down over two octaves at a fixed velocity, latched, restarting on every beat."
    },
    "params": {
      "0": 2.0,
      "1": 4.0,
      "2": 50.0,
      "3": 2.0,
      "4": 0.0,
      "5": 1.0,
      "6": 1.0,
      "7": 110.0,
      "8": 2.0
    }
  }
}
