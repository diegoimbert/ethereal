      "2": -80.0,
      "3": 4.0,
      "4": 0.0,
      "5": 0.05,
      "6": 40.0,
      "7": 120.0,
      "8": 2.0,
      "9": 60.0,
      "10": 0.0,
      "11": 0.0
    }
  }
