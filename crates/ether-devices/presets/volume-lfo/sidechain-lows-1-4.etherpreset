{
  "format": "ethereal-preset",
  "version": 1,
  "app_version": "0.6.0",
  "preset": {
    "name": "sidechain lows 1/4",
    "device": {
      "type": "Builtin",
      "device": "VolumeLfo"
    },
    "meta": {
      "tags": [
        "volume shaper",
        "sidechain",
        "pump",
        "multiband",
        "bass"
      ],
      "author": "ethereal",
      "description": "ducks only the low end at every beat, so the kick gets room and the rest of the sound stays put."
    },
    "params": {
      "0": 1.0,
      "1": 1.0,
      "2": 8.0,
      "3": 100.0,
      "4": 0.0,
      "5": 0.0,
      "6": 1.0,
      "7": 0.0,
      "8": 1.0,
      "9": 200.0,
      "10": 15000.0,
      "11": 100.0,
      "12": 100.0,
      "13": 2.0,
      "14": 2.0
    },
    "kind": {
      "type": "VolumeLfo",
      "curve": {"points": [
          {"x": 0.0, "y": 1.0, "curve": {"type": "Linear"}},
          {"x": 0.02, "y": 0.0, "curve": {"type": "Curve", "tension": -0.45}},
          {"x": 0.6, "y": 1.0, "curve": {"type": "Linear"}}
        ]},
      "bands": [
        {"points": [{"x": 0.0, "y": 1.0, "curve": {"type": "Linear"}}]}
      ]
    }
  }
}
