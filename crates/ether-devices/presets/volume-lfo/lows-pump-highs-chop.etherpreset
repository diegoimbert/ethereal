{
  "format": "ethereal-preset",
  "version": 1,
  "app_version": "0.6.0",
  "preset": {
    "name": "lows pump, highs chop",
    "device": {
      "type": "Builtin",
      "device": "VolumeLfo"
    },
    "meta": {
      "tags": [
        "volume shaper",
        "multiband",
        "pump",
        "gate",
        "rhythmic"
      ],
      "author": "ethereal",
      "description": "the lows pump at every beat while the highs chop on sixteenths; the mids stay put."
    },
    "params": {
      "0": 1.0,
      "1": 1.0,
      "2": 8.0,
      "3": 100.0,
      "4": 0.0,
      "5": 0.0,
      "6": 1.0,
      "7": 0.0,
      "8": 2.0,
      "9": 150.0,
      "10": 6000.0,
      "11": 100.0,
      "12": 60.0,
      "13": 2.0,
      "14": 5.0
    },
    "kind": {
      "type": "VolumeLfo",
      "curve": {"points": [
          {"x": 0.0, "y": 1.0, "curve": {"type": "Linear"}},
          {"x": 0.02, "y": 0.0, "curve": {"type": "Curve", "tension": -0.45}},
          {"x": 0.6, "y": 1.0, "curve": {"type": "Linear"}}
        ]},
      "bands": [
        {"points": [{"x": 0.0, "y": 1.0, "curve": {"type": "Linear"}}]},
        {"points": [
          {"x": 0.0, "y": 1.0, "curve": {"type": "Step"}},
          {"x": 0.5, "y": 0.0, "curve": {"type": "Step"}}
        ]}
      ]
    }
  }
}
