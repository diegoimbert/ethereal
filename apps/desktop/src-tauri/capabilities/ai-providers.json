{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ai-providers",
  "description": "The in-app AI chat calls its model providers from Rust (tauri-plugin-http, no CORS). Only the preset providers' default base URLs (ui/src/features/ai-chat/providers/catalog.ts) are allowed here; a base URL the user configures is added at runtime by `ai_http_allow` (src/ai_http.rs).",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.anthropic.com/*" },
        { "url": "https://api.openai.com/*" },
        { "url": "https://api.deepseek.com/*" },
        { "url": "https://generativelanguage.googleapis.com/*" },
        { "url": "https://api.mistral.ai/*" },
        { "url": "https://api.groq.com/*" },
        { "url": "https://openrouter.ai/*" },
        { "url": "https://api.together.xyz/*" },
        { "url": "http://localhost:11434/*" },
        { "url": "http://localhost:1234/*" }
      ]
    }
  ]
}
