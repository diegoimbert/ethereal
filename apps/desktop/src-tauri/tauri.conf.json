{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ethereal",
  "version": "0.0.1",
  "identifier": "dev.ethereal.app",
  "build": {
    "frontendDist": "../../../ui/dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": "pnpm --filter @ethereal/ui build"
  },
  "app": {
    "windows": [
      {
        "title": "Ethereal",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "copyright": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
